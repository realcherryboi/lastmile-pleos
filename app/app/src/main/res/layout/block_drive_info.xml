<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <!-- 도착 구역 스케치 + 정차·주차 사실 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="24dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zone_title"/>
            <TextView android:id="@+id/driveDestination" style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:textStyle="bold" android:gravity="end" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/mapSlotDrive" android:layout_width="match_parent" android:layout_height="440dp" android:background="@drawable/bg_map" android:clipToOutline="true" android:layout_marginTop="12dp">
            <kr.lastmile.app.ui.ZoneSketchView android:id="@+id/zoneSketch" android:layout_width="match_parent" android:layout_height="match_parent"/>
        </FrameLayout>
        <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="6dp" android:text="@string/map_credit"/>
        <View android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/outline" android:layout_marginTop="16dp" android:layout_marginBottom="18dp"/>
        <include android:id="@+id/factCurb" layout="@layout/row_fact"/>
        <include android:id="@+id/factValet" layout="@layout/row_fact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"/>
        <include android:id="@+id/factParking" layout="@layout/row_fact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/meetingStatusCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_card" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="22dp" android:paddingBottom="22dp" android:layout_marginTop="@dimen/gutter">
        <ImageView android:id="@+id/meetingStatusIcon" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_message" android:tint="@color/text_primary"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="20dp">
            <TextView android:id="@+id/meetingStatusTitle" style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:text="@string/meeting_mode"/>
            <TextView android:id="@+id/meetingStatusText" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
