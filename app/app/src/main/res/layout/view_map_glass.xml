<?xml version="1.0" encoding="utf-8"?>
<!-- 지도 위에 떠 있는 유리 레이어: 제목 캡슐(좌상), 현재 위치로 버튼(우하), 출처 캡슐(좌하). 지도 슬롯(FrameLayout) 안에서 MapView 위에 놓인다. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:id="@+id/glassTitle" android:layout_width="wrap_content" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_gravity="top|start" android:layout_margin="16dp" android:paddingStart="18dp" android:paddingEnd="24dp"
        android:background="@drawable/bg_glass" android:elevation="8dp" android:outlineProvider="background" android:maxWidth="560dp">
        <ImageView android:id="@+id/glassIcon" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_flag" android:tint="@color/text_primary"/>
        <TextView android:id="@+id/glassText" style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textColor="@color/text_primary" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:maxWidth="460dp"/>
    </LinearLayout>
    <ImageButton android:id="@+id/recenterButton" android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="bottom|end" android:layout_margin="16dp"
        android:background="@drawable/bg_glass_circle" android:elevation="8dp" android:outlineProvider="background" android:src="@drawable/ic_navigation" android:tint="@color/text_primary" android:padding="20dp" android:scaleType="fitCenter" android:contentDescription="@string/recenter"/>
    <TextView android:id="@+id/glassCredit" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center_vertical" android:layout_gravity="bottom|start" android:layout_margin="16dp"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:textSize="16sp" android:textColor="@color/text_secondary" android:background="@drawable/bg_glass" android:elevation="4dp" android:outlineProvider="background" android:text="@string/map_credit"/>
</merge>
