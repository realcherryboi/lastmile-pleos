<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:orientation="vertical">
        <EditText android:id="@+id/searchField" style="@style/Search" android:layout_width="match_parent" android:layout_height="88dp" android:hint="@string/search_hint"/>
        <TextView android:id="@+id/listTitle" style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginStart="8dp" android:text="@string/idle_subtitle"/>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp" android:overScrollMode="never" android:scrollbars="none" android:clipToPadding="false" android:paddingBottom="8dp">
            <LinearLayout android:id="@+id/destList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        </ScrollView>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:orientation="vertical" android:layout_marginStart="@dimen/gutter">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ScrollView android:id="@+id/detailScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" android:scrollbars="none" android:visibility="gone">
                <include android:id="@+id/detailCard" layout="@layout/card_detail"/>
            </ScrollView>
            <LinearLayout android:id="@+id/detailEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_card_outline" android:padding="@dimen/card_padding">
                <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_flag" android:tint="@color/text_tertiary"/>
                <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:textColor="@color/text_secondary" android:text="@string/detail_empty"/>
            </LinearLayout>
        </FrameLayout>
        <Button android:id="@+id/startButton" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/gutter" android:text="@string/start_guidance" android:enabled="false"/>
    </LinearLayout>
</LinearLayout>
