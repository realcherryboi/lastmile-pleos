<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <!-- 잠시 정차 배너 -->
    <LinearLayout android:id="@+id/stoppingBanner" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_banner_warning" android:padding="28dp" android:layout_marginBottom="@dimen/gutter" android:visibility="gone">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_clock" android:tint="@color/warning"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="20dp">
            <TextView android:id="@+id/stoppingTitle" style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:text="@string/stopping_title"/>
            <TextView android:id="@+id/stoppingHint" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 다음 안내 (내비의 다음 교차로 패널에 해당) -->
    <LinearLayout android:id="@+id/nextCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_card" android:padding="28dp">
        <FrameLayout android:layout_width="104dp" android:layout_height="104dp" android:background="@drawable/bg_circle_accent_soft">
            <ImageView android:id="@+id/nextIcon" android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" android:src="@drawable/ic_flag" android:tint="@color/accent"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="28dp" android:layout_marginEnd="16dp">
            <TextView android:id="@+id/nextLabel" style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/next_briefing"/>
            <TextView android:id="@+id/nextTitle" style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/nextPreview" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:maxLines="2" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/nextCountdown" style="@style/Text.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent"/>
    </LinearLayout>

    <!-- 마지막 음성 안내 -->
    <LinearLayout android:id="@+id/spokenRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp" android:paddingStart="12dp" android:paddingEnd="12dp">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_volume" android:tint="@color/text_secondary"/>
        <TextView android:id="@+id/driveGuidance" style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/text_secondary"/>
    </LinearLayout>
    <kr.lastmile.app.ui.RouteProgressView android:id="@+id/routeProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"/>
</LinearLayout>
