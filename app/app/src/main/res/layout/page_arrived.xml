<?xml version="1.0" encoding="utf-8"?>
<!-- 도착 전체 창(시안 11/8): 왼쪽 60% = 제목 → 카드 2개(정차/주차 · 승하차 대기) → 완료, 오른쪽 40% = 도착 구역 지도 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_weight="3" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:id="@+id/arrivedBadge" android:layout_width="112dp" android:layout_height="112dp" android:background="@drawable/bg_circle_success">
                <ImageView android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:tint="#FFFFFF"/>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="28dp">
                <TextView android:id="@+id/arrivedTitle" style="@style/Text.Headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="@string/arrived_title"/>
                <TextView android:id="@+id/arrivedDestination" style="@style/Text.Label" android:textSize="28sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/arrivedCards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="@dimen/gutter">
            <!-- 정차 타이머 / 주차 -->
            <LinearLayout android:id="@+id/curbCard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_card" android:paddingStart="36dp" android:paddingEnd="36dp" android:paddingTop="32dp" android:paddingBottom="32dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/curbIcon" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_timer" android:tint="@color/text_primary"/>
                    <TextView android:id="@+id/curbTitle" style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/curbTimer" style="@style/Text.Display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="96sp"/>
                <ProgressBar android:id="@+id/curbProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginTop="12dp" android:max="1000" android:progressDrawable="@drawable/progress_track"/>
                <TextView android:id="@+id/parkName" style="@style/Text.Title" android:textSize="48sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:maxLines="2"/>
                <TextView android:id="@+id/parkFee" style="@style/Text.Title" android:textSize="36sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/accent"/>
                <TextView android:id="@+id/curbHint" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:maxLines="3"/>
                <TextView android:id="@+id/parkHint" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_tertiary" android:maxLines="2"/>
            </LinearLayout>
            <!-- 승하차 대기 + 마중 알림 -->
            <LinearLayout android:id="@+id/parkCard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_card" android:paddingStart="36dp" android:paddingEnd="36dp" android:paddingTop="32dp" android:paddingBottom="32dp" android:layout_marginStart="@dimen/gutter">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_person" android:tint="@color/text_primary"/>
                    <TextView android:id="@+id/boardTitle" style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:textStyle="bold" android:text="@string/boarding_wait_title"/>
                </LinearLayout>
                <TextView android:id="@+id/boardHint" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:maxLines="3" android:text="@string/boarding_wait_hint"/>
                <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
                <LinearLayout android:id="@+id/arrivedMessageCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp" android:visibility="gone">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_message" android:tint="@color/success"/>
                    <TextView android:id="@+id/arrivedMessageText" style="@style/Text.Label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textStyle="bold" android:textColor="@color/success" android:maxLines="2" android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
        <Button android:id="@+id/doneButton" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/gutter" android:text="@string/done"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/mapSlotArrived" android:layout_width="0dp" android:layout_weight="2" android:layout_height="match_parent" android:layout_marginStart="@dimen/gutter" android:background="@drawable/bg_map" android:clipToOutline="true">
        <kr.lastmile.app.ui.ZoneSketchView android:id="@+id/arrivedSketch" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <include layout="@layout/view_map_glass"/>
    </FrameLayout>
</LinearLayout>
