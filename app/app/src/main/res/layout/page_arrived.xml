<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal">
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
    <FrameLayout android:layout_width="160dp" android:layout_height="160dp" android:background="@drawable/bg_circle_success">
        <ImageView android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:tint="#FFFFFF"/>
    </FrameLayout>
    <TextView style="@style/Text.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="36dp" android:text="@string/arrived_title"/>
    <TextView android:id="@+id/arrivedDestination" style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary"/>
    <TextView android:id="@+id/arrivedNote" style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center"/>
    <LinearLayout android:id="@+id/arrivedMessageCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_banner_success" android:padding="@dimen/card_padding" android:layout_marginTop="36dp" android:visibility="gone">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_message" android:tint="@color/success"/>
        <TextView android:id="@+id/arrivedMessageText" style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
    <Button android:id="@+id/doneButton" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:text="@string/done"/>
</LinearLayout>
