<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/factIcon" android:layout_width="40dp" android:layout_height="40dp" android:tint="@color/text_primary"/>
    <TextView android:id="@+id/factLabel" style="@style/Text.Label" android:layout_width="92dp" android:layout_height="wrap_content" android:layout_marginStart="18dp"/>
    <TextView android:id="@+id/factValue" style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>
