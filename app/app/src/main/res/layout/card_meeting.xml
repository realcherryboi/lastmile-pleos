<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/bg_card" android:padding="@dimen/card_padding" android:gravity="center_vertical">
    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_bell" android:tint="@color/text_primary"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="24dp" android:layout_marginEnd="16dp">
        <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:text="@string/meeting_mode"/>
        <TextView android:id="@+id/meetingDesc" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/meeting_off"/>
    </LinearLayout>
    <FrameLayout android:layout_width="120dp" android:layout_height="64dp">
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/meetingSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:scaleX="1.5" android:scaleY="1.5"/>
    </FrameLayout>
</LinearLayout>
