<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="0dp" android:layout_height="@dimen/tile_height"
    android:orientation="vertical" android:background="@drawable/bg_tile" android:padding="28dp" android:gravity="bottom" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/tileIcon" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_pin" android:tint="@color/text_primary"/>
    <TextView android:id="@+id/tileName" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:lineSpacingMultiplier="1.1"/>
    <TextView android:id="@+id/tileCategory" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
</LinearLayout>
