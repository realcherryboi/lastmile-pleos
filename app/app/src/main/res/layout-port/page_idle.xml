<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <EditText android:id="@+id/searchField" style="@style/Search" android:layout_width="match_parent" android:layout_height="88dp" android:hint="@string/search_hint"/>
    <ScrollView android:id="@+id/detailScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="@dimen/gutter" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <include android:id="@+id/detailCard" layout="@layout/card_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
            <View android:id="@+id/detailEmpty" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/listTitle" style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginStart="8dp" android:text="@string/idle_subtitle"/>
            <LinearLayout android:id="@+id/destList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/startButton" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/gutter" android:text="@string/start_guidance" android:enabled="false"/>
</LinearLayout>
