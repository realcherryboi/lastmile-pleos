<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView style="@style/Text.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/idle_title"/>
    <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/idle_subtitle"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="24dp" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <GridLayout android:id="@+id/tileGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="@integer/tile_columns" android:useDefaultMargins="false"/>
            <include android:id="@+id/meetingCard" layout="@layout/card_meeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gutter"/>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/startButton" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/gutter" android:text="@string/start_guidance" android:enabled="false"/>
</LinearLayout>
