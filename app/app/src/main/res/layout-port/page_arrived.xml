<?xml version="1.0" encoding="utf-8"?>
<!-- 도착 반 창(세로): 제목 → 정차/주차 카드 → 승하차 대기 카드 → 지도(남는 높이) → 완료 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/arrivedBadge" android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/bg_circle_success">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:tint="#FFFFFF"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="22dp">
            <TextView android:id="@+id/arrivedTitle" style="@style/Text.Headline" android:textSize="52sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="@string/arrived_title"/>
            <TextView android:id="@+id/arrivedDestination" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/arrivedCards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
        <LinearLayout android:id="@+id/curbCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="28dp" android:paddingBottom="28dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/curbIcon" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_timer" android:tint="@color/text_primary"/>
                <TextView android:id="@+id/curbTitle" style="@style/Text.Body" android:textSize="28sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:id="@+id/curbTimer" style="@style/Text.Display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="84sp"/>
            <ProgressBar android:id="@+id/curbProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="10dp" android:max="1000" android:progressDrawable="@drawable/progress_track"/>
            <TextView android:id="@+id/parkName" style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:maxLines="2"/>
            <TextView android:id="@+id/parkFee" style="@style/Text.Title" android:textSize="34sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/accent"/>
            <TextView android:id="@+id/curbHint" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:maxLines="3"/>
            <TextView android:id="@+id/parkHint" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_tertiary" android:maxLines="2"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/parkCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="26dp" android:paddingBottom="26dp" android:layout_marginTop="20dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_person" android:tint="@color/text_primary"/>
                <TextView android:id="@+id/boardTitle" style="@style/Text.Body" android:textSize="28sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textStyle="bold" android:text="@string/boarding_wait_title"/>
            </LinearLayout>
            <TextView android:id="@+id/boardHint" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:maxLines="2" android:text="@string/boarding_wait_hint"/>
            <LinearLayout android:id="@+id/arrivedMessageCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp" android:visibility="gone">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_message" android:tint="@color/success"/>
                <TextView android:id="@+id/arrivedMessageText" style="@style/Text.Label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textStyle="bold" android:textColor="@color/success" android:maxLines="2" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/mapSlotArrived" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="200dp" android:layout_marginTop="20dp" android:background="@drawable/bg_map" android:clipToOutline="true">
        <kr.lastmile.app.ui.ZoneSketchView android:id="@+id/arrivedSketch" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <include layout="@layout/view_map_glass"/>
    </FrameLayout>
    <Button android:id="@+id/doneButton" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="20dp" android:text="@string/done"/>
</LinearLayout>
