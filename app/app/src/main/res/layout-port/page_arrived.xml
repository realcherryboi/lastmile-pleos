<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="112dp" android:layout_height="112dp" android:background="@drawable/bg_circle_success">
            <ImageView android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:tint="#FFFFFF"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="28dp">
            <TextView style="@style/Text.Headline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/arrived_title"/>
            <TextView android:id="@+id/arrivedDestination" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="@dimen/gutter" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/arrivedCards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/curbCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="@dimen/card_padding">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:id="@+id/curbIcon" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_timer" android:tint="@color/text_primary"/>
                        <TextView android:id="@+id/curbTitle" style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:id="@+id/curbTimer" style="@style/Text.Display" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="96sp"/>
                    <ProgressBar android:id="@+id/curbProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="14dp" android:layout_marginTop="16dp" android:max="1000" android:progressDrawable="@drawable/progress_track"/>
                    <TextView android:id="@+id/curbHint" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:maxLines="3"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/parkCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="@dimen/card_padding" android:layout_marginTop="@dimen/gutter">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_parking" android:tint="@color/text_primary"/>
                        <TextView style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:textStyle="bold" android:text="@string/parking_lot"/>
                    </LinearLayout>
                    <TextView android:id="@+id/parkName" style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:maxLines="2"/>
                    <TextView android:id="@+id/parkFee" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/accent" android:textStyle="bold"/>
                    <TextView android:id="@+id/parkHint" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:maxLines="3"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="24dp" android:paddingBottom="20dp" android:layout_marginTop="@dimen/gutter">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/zone_title"/>
                    <TextView android:id="@+id/arrivedMeet" style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:textStyle="bold" android:gravity="end" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
                <FrameLayout android:id="@+id/mapSlotArrived" android:layout_width="match_parent" android:layout_height="400dp" android:background="@drawable/bg_map" android:clipToOutline="true" android:layout_marginTop="12dp">
                    <kr.lastmile.app.ui.ZoneSketchView android:id="@+id/arrivedSketch" android:layout_width="match_parent" android:layout_height="match_parent"/>
                </FrameLayout>
                <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="6dp" android:text="@string/map_credit"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/arrivedMessageCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_banner_success" android:padding="28dp" android:layout_marginTop="@dimen/gutter" android:visibility="gone">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_message" android:tint="@color/success"/>
                <TextView android:id="@+id/arrivedMessageText" style="@style/Text.Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:maxLines="2" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/doneButton" style="@style/Button.Primary" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/gutter" android:text="@string/done"/>
</LinearLayout>
