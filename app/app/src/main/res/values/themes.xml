<resources>
    <style name="Theme.LastMile" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/button_primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="bottomSheetDialogTheme">@style/Theme.LastMile.Sheet</item>
    </style>
    <style name="Theme.LastMile.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.LastMile.Sheet</item>
    </style>
    <style name="Widget.LastMile.Sheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_sheet</item>
        <item name="backgroundTint">@null</item>
        <item name="android:maxWidth">1400dp</item>
        <item name="behavior_skipCollapsed">true</item>
        <item name="behavior_fitToContents">true</item>
    </style>

    <!-- Type scale -->
    <style name="Text" ><item name="android:textColor">@color/text_primary</item><item name="android:includeFontPadding">false</item></style>
    <style name="Text.Display"><item name="android:textSize">@dimen/text_display</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">-0.03</item></style>
    <style name="Text.Headline"><item name="android:textSize">@dimen/text_headline</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">-0.02</item></style>
    <style name="Text.Title"><item name="android:textSize">@dimen/text_title</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">-0.01</item></style>
    <style name="Text.Body"><item name="android:textSize">@dimen/text_body</item><item name="android:lineSpacingMultiplier">1.25</item></style>
    <style name="Text.Label"><item name="android:textSize">@dimen/text_label</item><item name="android:textColor">@color/text_secondary</item></style>
    <style name="Text.Caption"><item name="android:textSize">@dimen/text_caption</item><item name="android:textColor">@color/text_tertiary</item></style>

    <!-- Buttons: 96dp pill, shrink on press handled in code -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_pill_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/text_on_primary</item><item name="iconSize">40dp</item><item name="iconPadding">16dp</item><item name="iconGravity">textStart</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">48dp</item><item name="android:paddingEnd">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">@color/text_on_primary</item>
    </style>
    <style name="Button.Secondary" parent="Button.Primary">
        <item name="android:background">@drawable/bg_pill_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
    </style>
    <style name="Button.Icon" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:layout_width">@dimen/icon_button</item>
        <item name="android:layout_height">@dimen/icon_button</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:padding">24dp</item>
        <item name="android:tint">@color/text_primary</item>
    </style>
    <style name="Chip"><item name="android:background">@drawable/bg_chip</item><item name="android:minHeight">@dimen/chip_height</item><item name="android:gravity">center</item><item name="android:paddingStart">24dp</item><item name="android:paddingEnd">24dp</item><item name="android:textSize">@dimen/text_label</item><item name="android:textColor">@color/text_primary</item><item name="android:textStyle">bold</item></style>
    <style name="Field"><item name="android:background">@drawable/bg_field</item><item name="android:minHeight">88dp</item><item name="android:paddingStart">28dp</item><item name="android:paddingEnd">28dp</item><item name="android:textSize">@dimen/text_body</item><item name="android:textColor">@color/text_primary</item><item name="android:textColorHint">@color/text_tertiary</item></style>
</resources>
